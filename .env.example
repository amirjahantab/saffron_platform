# ==============================================================================
# Saffron E-Commerce Platform - Sample Environment Configuration
# WARNING: Copy this file to .env and replace sample values with real secrets.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# Django Core Settings
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-in-local-env-with-a-50-char-random-string-0123456789
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],0.0.0.0
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_LOG_LEVEL=INFO

# PostgreSQL Database Settings
POSTGRES_DB=saffron_db
POSTGRES_USER=saffron_user
POSTGRES_PASSWORD=saffron_local_dev_password_change_me
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# Redis Cache & Rate-Limiting Settings
REDIS_URL=redis://redis:6379/1

# Phase 2: OTP & SMS Authentication Settings
OTP_CODE_LENGTH=6
OTP_EXPIRY_SECONDS=120
OTP_RESEND_COOLDOWN_SECONDS=120
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_HOUR_PHONE=5
OTP_MAX_REQUESTS_PER_HOUR_IP=10
SMS_PROVIDER_CLASS=apps.accounts.services.sms_provider.SandboxSMSProvider

# Phase 4: Order & Inventory Reservation Settings
ORDER_RESERVATION_EXPIRY_MINUTES=15
ORDER_DEFAULT_SHIPPING_COST_RIAL=450000
ORDER_FREE_SHIPPING_THRESHOLD_RIAL=15000000

# Phase 5: Payment Gateway Settings
PAYMENT_DEFAULT_GATEWAY=sandbox
PAYMENT_CALLBACK_BASE_URL=http://127.0.0.1:8000
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
ZARINPAL_SANDBOX=True
ZARINPAL_TIMEOUT_SECONDS=10

# Security Settings (Enforced in Production)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
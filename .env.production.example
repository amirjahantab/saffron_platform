# Copy to .env.production, use new random secrets, and configure your real domain.
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=replace-with-an-independent-strong-random-secret-at-least-50-characters
DJANGO_ALLOWED_HOSTS=shop.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://shop.example.com
SITE_URL=https://shop.example.com
DJANGO_DEBUG=False
DEMO_MODE=False
STORE_OPEN=False
POSTGRES_DB=saffron_db
POSTGRES_USER=saffron_user
POSTGRES_PASSWORD=replace-with-a-random-database-secret
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_PASSWORD=replace-with-a-random-url-safe-redis-secret
TRUST_PROXY_HEADERS=True
PAYMENT_DEFAULT_GATEWAY=zarinpal
PAYMENT_CALLBACK_BASE_URL=https://shop.example.com
ZARINPAL_MERCHANT_ID=replace-with-the-real-merchant-id
ZARINPAL_SANDBOX=False
ZARINPAL_TIMEOUT_SECONDS=10
SMS_PROVIDER_CLASS=apps.accounts.services.sms_provider.KavenegarSMSProvider
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=
KAVENEGAR_SENDER=
NOTIFICATIONS_ENABLED=False
ASSISTANT_ENABLED=False
OPENAI_API_KEY=
OPENAI_MODEL=
ASSISTANT_HOURLY_LIMIT=10
ASSISTANT_DAILY_TOKEN_BUDGET=100000
ANALYTICS_RETENTION_DAYS=90
MESSAGE_RETENTION_DAYS=90
SUPPORT_RETENTION_DAYS=365
WEB_CONCURRENCY=3
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

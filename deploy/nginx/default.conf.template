resolver 127.0.0.11 valid=10s ipv6=off;
upstream jahantab_app {
    zone jahantab_backend 64k;
    server web:8000 resolve;
}
map $uri $authentication_limit_key {
    default "";
    ~^/(admin/login|auth/login|accounts/otp)/ $binary_remote_addr;
}
limit_req_zone $binary_remote_addr zone=store_requests:10m rate=10r/s;
limit_req_zone $authentication_limit_key zone=authentication:10m rate=5r/m;
limit_req_status 429;
server {
    listen 8080;
    server_name _;
    location / { return 301 ${SITE_URL}$request_uri; }
}
server {
    listen 8443 ssl;
    http2 on;
    server_name _;
    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    server_tokens off;
    client_max_body_size 5m;
    # Avoid logging private URL paths and payment parameters.
    access_log off;
    gzip on;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    location /static/ {
        alias /srv/static/;
        expires 7d;
        add_header X-Content-Type-Options nosniff always;
        add_header Cache-Control "public";
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    }
    location /media/catalog/certificates/ { return 404; }
    location ~* ^/media/.*\.(?:php|html?|js|svg|xml|pdf)$ { return 404; }
    location /media/ {
        alias /srv/media/;
        autoindex off;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Robots-Tag noindex always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        expires 1d;
    }
    location / {
        limit_req zone=store_requests burst=30 nodelay;
        limit_req zone=authentication burst=10 nodelay;
        proxy_pass http://jahantab_app;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 45s;
        proxy_connect_timeout 5s;
        proxy_redirect off;
    }
}
